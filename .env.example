# Groq API Key (Free tier from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM model (default: openai/gpt-oss-120b)
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Speech-to-Text Language (default: en)
# Setting to 'en' optimizes Whisper latency and eliminates multilingual misdetection
STT_LANGUAGE=en

# Edge TTS voice (default: en-US-GuyNeural)
# Options: en-US-GuyNeural, en-US-AriaNeural, en-US-JennyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-GuyNeural

# FastAPI server port (default: 8000)
BACKEND_PORT=8000

# CORS origins allowed to call the backend (dev default: Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
